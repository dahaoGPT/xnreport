        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "left",
            "right"
          ],
          "properties": {
            "operator": {
              "type": "string",
              "enum": [
                "EQ",
                "NE",
                "GT",
                "GE",
                "LT",
                "LE",
                "IN",
                "NOT_IN",
                "BETWEEN",
                "CONTAINS",
                "STARTS_WITH",
                "ENDS_WITH"
              ]
            },
            "left": {
              "$ref": "#/definitions/valueReference"
            },
            "right": {
              "$ref": "#/definitions/valueReference"
            },
            "ignoreCase": {
              "type": "boolean"
            }
          }
        }
      ]
