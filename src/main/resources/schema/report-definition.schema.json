        "divideByZeroStrategy": {
          "type": "string",
          "enum": [
            "FAIL",
            "NULL"
          ]
        },
        "fieldConflictStrategy": {
          "type": "string",
          "enum": [
            "FAIL",
            "REPLACE"
          ]
        }
      }
    },
    "derivedDivideDefaultValueTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetField",
        "sourceField",
        "operator",
        "operand",
        "divideByZeroStrategy",
        "divideByZeroDefault"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DERIVED_FIELD"
