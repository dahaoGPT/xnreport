        "operator": {
          "type": "string",
          "enum": [
            "DIVIDE"
          ]
        },
        "operand": {
          "type": "number"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "divideByZeroStrategy": {
          "type": "string",
          "enum": [
            "DEFAULT_VALUE"
          ]
        },
        "divideByZeroDefault": {
          "type": "number"
        },
        "fieldConflictStrategy": {
          "type": "string",
          "enum": [
            "FAIL",
            "REPLACE"
          ]
        }
      }
    },
    "sortField": {
      "type": "object",
      "additionalProperties": false,
