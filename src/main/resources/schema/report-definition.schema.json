        "targetField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "sourceField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "operator": {
          "type": "string",
          "enum": [
            "ADD",
            "SUBTRACT",
            "MULTIPLY"
          ]
        },
        "operand": {
          "type": "number"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "fieldConflictStrategy": {
          "type": "string",
          "enum": [
            "FAIL",
            "REPLACE"
          ]
        }
      }
    },
    "derivedDivideDefaultTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetField",
        "sourceField",
        "operator",
        "operand"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DERIVED_FIELD"
          ]
        },
        "targetField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "sourceField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "operator": {
          "type": "string",
          "enum": [
            "DIVIDE"
          ]
        },
        "operand": {
          "type": "number"
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "fieldConflictStrategy": {
          "type": "string",
          "enum": [
            "FAIL",
            "REPLACE"
          ]
        }
      }
    },
    "derivedDividePolicyTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetField",
        "sourceField",
        "operator",
        "operand",
        "divideByZeroStrategy"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DERIVED_FIELD"
          ]
        },
        "targetField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "sourceField": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "operator": {
          "type": "string",
          "enum": [
            "DIVIDE"
          ]
