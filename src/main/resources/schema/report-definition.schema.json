{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xn.example/schema/report-definition.schema.json",
  "title": "Report Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "report",
    "datasets"
  ],
  "properties": {
