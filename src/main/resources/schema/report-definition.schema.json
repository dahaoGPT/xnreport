            "dataset": {
              "type": "string",
              "minLength": 1,
              "x-java-nonBlank": true
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "x-java-nonBlank": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "parameter"
          ],
          "properties": {
            "source": {
              "type": "string",
