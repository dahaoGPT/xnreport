      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "word": {
      "$ref": "#/definitions/word"
    },
    "policies": {
      "$ref": "#/definitions/policies"
    }
