            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "dataset",
            "field"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "DATASET_FIELD"
