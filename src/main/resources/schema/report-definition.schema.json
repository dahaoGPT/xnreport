  "definitions": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "excelTemplate": {
          "type": "string"
        },
        "wordTemplate": {
          "type": "string"
        },
        "excelFileName": {
          "type": "string"
        },
        "wordFileName": {
          "type": "string"
        },
        "collisionPolicy": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "defaultValue": {}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sheetName"
      ],
      "oneOf": [
        {
          "required": [
            "sqlFile"
          ]
        },
        {
          "required": [
            "sql"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!')(?!.*'$)[^\\\\/?*\\[\\]:]+$",
          "description": "Runtime maximum is 31 Java UTF-16 code units, matching Apache POI; Draft-07 maxLength is intentionally omitted because it counts Unicode code points.",
          "x-java-maxUtf16Length": 31,
          "x-java-nonBlank": true
        },
        "sqlFile": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "x-java-nonBlank": true
        },
        "resultType": {
          "type": "string",
          "enum": [
            "SCALAR",
            "SINGLE",
            "LIST"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object"
        },
        "expectedFields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/field"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transform"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "transform": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field",
            "operator",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "FILTER"
              ]
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "x-java-nonBlank": true
            },
            "operator": {
              "type": "string",
              "enum": [
                "EQUAL",
                "EQ",
                "NOT_EQUAL",
                "NE",
                "GREATER_THAN",
                "GT",
                "GREATER_THAN_OR_EQUAL",
                "GTE",
                "LESS_THAN",
                "LT",
                "LESS_THAN_OR_EQUAL",
                "LTE"
              ]
            },
            "value": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array"
                },
                {
                  "type": "object"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field",
            "operator"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "FILTER"
              ]
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "x-java-nonBlank": true
            },
            "operator": {
              "type": "string",
              "enum": [
                "IS_NULL",
                "IS_NOT_NULL"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sortFields"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "SORT"
              ]
            },
            "sortFields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/sortField"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "fields"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "DISTINCT"
              ]
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "x-java-nonBlank": true
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "limit"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "LIMIT"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "$ref": "#/definitions/derivedNonDivideTransform"
        },
        {
          "$ref": "#/definitions/derivedDivideDefaultTransform"
        },
        {
          "$ref": "#/definitions/derivedDividePolicyTransform"
        },
        {
          "$ref": "#/definitions/derivedDivideDefaultValueTransform"
        }
      ]
    },
    "derivedNonDivideTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targetField",
        "sourceField",
        "operator",
        "operand"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DERIVED_FIELD"
          ]
